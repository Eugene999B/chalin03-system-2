{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci"
  },
  "deploy": {
    "startCommand": "node scripts/verifyChalinOneFullStagingEnvironment.js --mode=runtime && npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

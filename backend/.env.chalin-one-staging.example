# CHALIN ONE isolated staging preview
# Copy to a secure staging environment. Never use these placeholder values as secrets.

NODE_ENV=staging
PORT=5000
APP_VERSION=3.0.0-chalin-one-staging

# Staging must use non-production hosts.
FRONTEND_URL=https://preview.example-chalin03.com
FRONTEND_URL_ALT=https://staff-preview.example-chalin03.com
CHALIN_ONE_STAGING_API_URL=https://api-preview.example-chalin03.com
TRUSTED_API_HOSTS=api-preview.example-chalin03.com
ENFORCE_TRUSTED_API_HOSTS=true
CLOUDFLARE_ORIGIN_SECRET=replace_with_unique_staging_origin_secret_64_chars_minimum
ENFORCE_PRODUCTION_SECURITY_SECRETS=true

# Isolated staging database only. The verifier accepts only chalin_one_staging*
DB_HOST=staging-mysql-host
DB_PORT=3306
DB_USER=chalin_one_staging_user
DB_PASSWORD=replace_with_unique_staging_database_password
DB_NAME=chalin_one_staging
DB_CONNECTION_LIMIT=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=

JWT_SECRET=replace_with_unique_staging_jwt_secret_64_chars_minimum
BACKUP_SIGNING_SECRET=replace_with_unique_staging_backup_secret_64_chars_minimum
ACCOUNT_RECOVERY_OTP_SECRET=replace_with_unique_staging_recovery_secret_64_chars_minimum
OWNER_MFA_ENCRYPTION_KEY=replace_with_unique_staging_owner_mfa_secret_64_chars_minimum
ALLOW_WEB_RESTORE=false

SYSTEM_ADMIN_USER_ID=1
SYSTEM_ADMIN_USERNAME=admin
SMS_ENABLED=false
SMS_PROVIDER=mock
INSTALLMENT_SMS_REMINDERS_ENABLED=false

# Exact staging confirmation required by every staging command.
CHALIN_ONE_STAGING_CONFIRM=CHALIN_ONE_STAGING_PREVIEW_ONLY

# Three existing and different staging-only staff accounts.
CHALIN_ONE_STAGING_AUTHOR_USER_ID=1
CHALIN_ONE_STAGING_REVIEWER_USER_ID=2
CHALIN_ONE_STAGING_PUBLISHER_USER_ID=3

# Release B features enabled only in staging.
FEATURE_PUBLIC_WEBSITE=true
FEATURE_CONTENT_STUDIO=true

# Future releases remain disabled during website acceptance.
FEATURE_AI_ENABLED=false
FEATURE_CHALIN_COPILOT=false
FEATURE_CHALIN_EXECUTIVE=false
FEATURE_CHALIN_GUIDE=false
FEATURE_CUSTOMER_PORTAL=false
FEATURE_SUPPLIER_PORTAL=false
FEATURE_APPLICANT_PORTAL=false
FEATURE_AI_ACTIONS=false
FEATURE_AI_SCHEDULED_JOBS=false

PUBLIC_FORM_IP_HASH_SECRET=replace_with_unique_staging_public_form_hash_secret_64_chars_minimum
PUBLIC_CONTENT_READ_RATE_LIMIT_MAX=600
PUBLIC_FORM_SUBMISSION_RATE_LIMIT_MAX=12
PUBLIC_CONTENT_SCHEDULER_INTERVAL_MS=60000

# Staging smoke defaults are non-writing and do not require published content.
# Keep both false for environment verification and pre-publication smoke checks.
CHALIN_ONE_STAGING_REQUIRE_PUBLISHED=false
CHALIN_ONE_STAGING_SMOKE_SUBMIT_FORM=false

# Final isolated staging acceptance only, after governed approval and publication:
# CHALIN_ONE_STAGING_REQUIRE_PUBLISHED=true
# CHALIN_ONE_STAGING_SMOKE_SUBMIT_FORM=true
# npm run smoke:chalin-one:staging
# This creates one traceable enquiry in the isolated staging database.

# Local preview option. The dedicated path must include staging.
PUBLIC_MEDIA_STORAGE_PROVIDER=local
PUBLIC_MEDIA_LOCAL_ROOT=./storage/chalin-one-staging-media
PUBLIC_MEDIA_PUBLIC_BASE_URL=

# R2 staging option. If enabled, use a separate bucket containing staging.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=chalin03-public-media-staging
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_VIDEO_HOSTS=

# Normal staging runtime and content seeding keep migration gates closed.
CHALIN_ONE_ALLOW_SCHEMA_MIGRATION=false
CHALIN_ONE_PUBLIC_CONTENT_MIGRATION_CONFIRM=
CHALIN03_SIGNED_BACKUP_CONFIRMED=false
CHALIN03_SQL_BACKUP_CONFIRMED=false

# One-time staging migration command only:
# CHALIN_ONE_ALLOW_SCHEMA_MIGRATION=true
# CHALIN_ONE_PUBLIC_CONTENT_MIGRATION_CONFIRM=20260805_CHALIN_ONE_PUBLIC_CONTENT_FOUNDATION
# npm run verify:chalin-one:staging:migration
# npm run migrate:chalin-one:public-content
# Immediately restore both migration variables to false/blank afterward.

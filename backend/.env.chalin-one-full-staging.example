# CHALIN ONE isolated full staging preview
# Copy these names into the separate Railway staging service. Never use these
# placeholder values as secrets and never point this environment at production.

NODE_ENV=staging
PORT=5000
APP_VERSION=3.0.0-chalin-one-staging

# Dedicated preview hosts only.
FRONTEND_URL=https://chalin-one-preview.pages.dev
FRONTEND_URL_ALT=
CHALIN_ONE_STAGING_API_URL=https://chalin-one-staging.up.railway.app
TRUSTED_API_HOSTS=chalin-one-staging.up.railway.app
ENFORCE_TRUSTED_API_HOSTS=false
CLOUDFLARE_ORIGIN_SECRET=replace_with_unique_staging_origin_secret_64_chars_minimum
ENFORCE_PRODUCTION_SECURITY_SECRETS=false

# Dedicated Railway MySQL service in the staging environment.
# The simplest Railway path is to keep its default database name and prove
# isolation with the exact token below. Alternatively, a database named
# chalin_one_staging or chalin_one_staging_<name> is also accepted.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
CHALIN_ONE_STAGING_DATABASE_ISOLATION=RAILWAY_DEDICATED_STAGING_MYSQL
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA_BASE64=

# Generate unique 64+ character STAGING-ONLY values. Do not copy production secrets.
JWT_SECRET=replace_with_unique_staging_jwt_secret_64_chars_minimum
BACKUP_SIGNING_SECRET=replace_with_unique_staging_backup_secret_64_chars_minimum
ACCOUNT_RECOVERY_OTP_SECRET=replace_with_unique_staging_recovery_secret_64_chars_minimum
OWNER_MFA_ENCRYPTION_KEY=replace_with_unique_staging_owner_mfa_secret_64_chars_minimum
PUBLIC_FORM_IP_HASH_SECRET=replace_with_unique_staging_public_form_hash_secret_64_chars_minimum
ALLOW_WEB_RESTORE=false

SYSTEM_ADMIN_USER_ID=1
SYSTEM_ADMIN_USERNAME=admin

# Staging must never send live SMS.
SMS_ENABLED=false
SMS_PROVIDER=mock
INSTALLMENT_SMS_REMINDERS_ENABLED=false
SMS_DELIVERY_POLL_ENABLED=false

# Exact staging confirmation required by the external-staging safety gate.
CHALIN_ONE_STAGING_CONFIRM=CHALIN_ONE_STAGING_PREVIEW_ONLY

# Three existing and different staging-only staff accounts.
CHALIN_ONE_STAGING_AUTHOR_USER_ID=1
CHALIN_ONE_STAGING_REVIEWER_USER_ID=2
CHALIN_ONE_STAGING_PUBLISHER_USER_ID=3

# Full Website + AI trial features.
FEATURE_PUBLIC_WEBSITE=true
FEATURE_CONTENT_STUDIO=true
FEATURE_AI_ENABLED=true
FEATURE_CHALIN_COPILOT=true
FEATURE_CHALIN_EXECUTIVE=true
FEATURE_CHALIN_GUIDE=true

# Keep later/riskier capabilities disabled for the first external trial.
FEATURE_CUSTOMER_PORTAL=false
FEATURE_SUPPLIER_PORTAL=false
FEATURE_APPLICANT_PORTAL=false
FEATURE_AI_ACTIONS=false
FEATURE_AI_SCHEDULED_JOBS=false

# Start infrastructure smoke with the provider disabled. For the dedicated
# real-provider acceptance stage, configure the chosen provider secret in Railway,
# set AI_PROVIDER to that provider, and run the verifier with --mode=provider.
AI_PROVIDER=disabled
AI_ALLOW_MOCK_PROVIDER=false
AI_REQUEST_TOKEN_LIMIT=6000
AI_DAILY_USER_TOKEN_LIMIT=100000
AI_DAILY_WORKSPACE_TOKEN_LIMIT=1000000
AI_MAX_TOOL_CALLS_PER_REQUEST=6
AI_MONTHLY_COST_LIMIT_MICROS=0

PUBLIC_CONTENT_READ_RATE_LIMIT_MAX=600
PUBLIC_FORM_SUBMISSION_RATE_LIMIT_MAX=12
PUBLIC_CONTENT_SCHEDULER_INTERVAL_MS=60000

# Staging smoke defaults are non-writing and do not require published content.
CHALIN_ONE_STAGING_REQUIRE_PUBLISHED=false
CHALIN_ONE_STAGING_SMOKE_SUBMIT_FORM=false

# Local media is acceptable for the first infrastructure smoke. Railway local
# storage is ephemeral, so use a separate staging R2 bucket before media acceptance.
PUBLIC_MEDIA_STORAGE_PROVIDER=local
PUBLIC_MEDIA_LOCAL_ROOT=/tmp/chalin-one-staging-media
PUBLIC_MEDIA_PUBLIC_BASE_URL=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=chalin03-public-media-staging
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_VIDEO_HOSTS=

# Every CHALIN ONE migration gate MUST be false/blank during normal runtime.
CHALIN_ONE_ALLOW_SCHEMA_MIGRATION=false
CHALIN_ONE_PUBLIC_CONTENT_MIGRATION_CONFIRM=
CHALIN_ONE_ALLOW_AI_SCHEMA_MIGRATION=false
CHALIN_ONE_AI_MIGRATION_CONFIRM=
CHALIN_ONE_ALLOW_AI_ACTION_SCHEMA_MIGRATION=false
CHALIN_ONE_ALLOW_AI_SCHEDULED_SCHEMA_MIGRATION=false
CHALIN_ONE_ALLOW_PUBLIC_GUIDE_SCHEMA_MIGRATION=false
CHALIN_ONE_ALLOW_PORTAL_SECURITY_SCHEMA_MIGRATION=false
CHALIN_ONE_ALLOW_DOCUMENT_INTELLIGENCE_SCHEMA_MIGRATION=false

# Production-only backup confirmations remain false in isolated staging.
CHALIN03_SIGNED_BACKUP_CONFIRMED=false
CHALIN03_SQL_BACKUP_CONFIRMED=false

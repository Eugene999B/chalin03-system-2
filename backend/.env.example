NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ALT=http://localhost:3000
APP_VERSION=3.0.0

# Release 3F-E trusted API host and Cloudflare origin protection.
# Production keeps api.chalin03.com trusted and rejects Railway default hostnames.
TRUSTED_API_HOSTS=api.chalin03.com
ENFORCE_TRUSTED_API_HOSTS=true
# Leave blank until the identical secret is configured in Railway and injected by
# a Cloudflare request-header transform rule as x-chalin-origin-key.
CLOUDFLARE_ORIGIN_SECRET=

# Version Three broad API abuse protection. Sensitive login and administration
# routes retain their smaller dedicated limits.
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=1500

DB_HOST=localhost
DB_PORT=3306
DB_USER=chalin03_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=chalin03_db
DB_CONNECTION_LIMIT=10
DB_SSL=false

JWT_SECRET=change_this_to_a_very_long_secret_key

# Protected original System Administrator identity.
# This must match the one break-glass account allowed across all three categories.
SYSTEM_ADMIN_USER_ID=1
SYSTEM_ADMIN_USERNAME=admin

# SMS Settings
# Use mock while developing. Mock records SMS logs but sends no real SMS.
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_SENDER_ID=CHALIN03

# Arkesel Live SMS
# Put the real API key only in backend/.env, never in this example file.
SMS_ARKESEL_API_KEY=
SMS_ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2/sms/send
SMS_ARKESEL_REPORTS_URL=https://sms.arkesel.com/api/v2/sms/message-reports

# Automatic delivery confirmation
# The callback is sent with every Arkesel SMS when a webhook secret is present.
# Polling is also enabled as an automatic fallback, so staff do not confirm delivery.
SMS_DELIVERY_CALLBACK_URL=https://api.chalin03.com/api/sms/delivery-report
SMS_DELIVERY_WEBHOOK_SECRET=replace_with_a_long_random_secret
SMS_DELIVERY_POLL_ENABLED=true
SMS_DELIVERY_POLL_INTERVAL_MS=60000
SMS_DELIVERY_POLL_INITIAL_DELAY_MS=8000
SMS_DELIVERY_POLL_BATCH_SIZE=200
SMS_DELIVERY_POLL_LOOKBACK_HOURS=720
SMS_DELIVERY_POLL_MIN_AGE_SECONDS=30

# Hubtel optional backup
SMS_HUBTEL_CLIENT_ID=
SMS_HUBTEL_CLIENT_SECRET=
SMS_HUBTEL_BASE_URL=https://smsc.hubtel.com/v1/messages/send

# SMS Safety
SMS_TIMEOUT_MS=15000
SMS_MAX_BULK_RECIPIENTS=200
# Release 2A server-side session security
# A successful new login revokes the account's previous active session.
AUTH_SESSION_TTL_DAYS=7
# Release 2A.2 secure SMS OTP recovery
# Use a different long random value from JWT_SECRET in production.
ACCOUNT_RECOVERY_OTP_SECRET=replace_with_a_different_long_random_secret

# Release 2 Final privileged security windows
PROTECTED_ACTION_WINDOW_MINUTES=10
OWNER_RECOVERY_SESSION_MINUTES=15
OWNER_RECOVERY_MAX_FAILED_ATTEMPTS=5

# Release 3F-B automatic installment reminders.
# Keep false until management confirms live reminder timing and approved SMS credit use.
INSTALLMENT_SMS_REMINDERS_ENABLED=false
INSTALLMENT_REMINDER_INTERVAL_MINUTES=180

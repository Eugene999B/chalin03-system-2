NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ALT=http://localhost:3000
APP_VERSION=3.0.0

# Release 3F-E trusted API host and Cloudflare origin protection.
# Production keeps api.chalin03.com trusted and rejects Railway default hostnames.
TRUSTED_API_HOSTS=api.chalin03.com
ENFORCE_TRUSTED_API_HOSTS=true
# Use a unique 64+ character random value in Railway and inject the identical
# value through Cloudflare as x-chalin-origin-key before production starts.
CLOUDFLARE_ORIGIN_SECRET=replace_with_unique_cloudflare_origin_secret_64_chars_minimum
# Production refuses to start when this is false or any required secret is weak.
ENFORCE_PRODUCTION_SECURITY_SECRETS=true

# Version Three broad API abuse protection. Sensitive login and administration
# routes retain their smaller dedicated limits.
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=1500

DB_HOST=localhost
DB_PORT=3306
DB_USER=chalin03_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=chalin03_db
DB_CONNECTION_LIMIT=10
# Local MySQL may use false. Railway production must use true.
DB_SSL=false
# Keep true for normal/public database hosts. Railway private MySQL may use false
# only when MYSQLHOST/DB_HOST ends in .railway.internal and the database presents
# its platform self-signed certificate.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional base64-encoded PEM CA. When present, certificate verification stays on.
DB_SSL_CA_BASE64=

# Production requires unique random values of at least 64 characters.
# Generate security values with: node scripts/generateProductionSecrets.js
JWT_SECRET=replace_with_unique_jwt_secret_64_chars_minimum
# Separate key used to authenticate full-system backup manifests.
# Never reuse JWT_SECRET, ACCOUNT_RECOVERY_OTP_SECRET, owner MFA or origin secrets.
BACKUP_SIGNING_SECRET=replace_with_unique_backup_signing_secret_64_chars_minimum
# Optional dedicated signing key for serialized inventory QR labels (32+ bytes).
# CHALIN ONE can derive an isolated stable fallback from a strong JWT_SECRET when
# this is omitted, but production should set a dedicated random value.
INVENTORY_LABEL_SIGNING_SECRET=
# Browser restore is local/test only. Production blocks web restore even if this
# value is accidentally enabled.
ALLOW_WEB_RESTORE=false

# Protected original System Administrator identity.
# This must match the one break-glass account allowed across all three categories.
SYSTEM_ADMIN_USER_ID=1
SYSTEM_ADMIN_USERNAME=admin

# SMS Settings
# Use mock while developing. Mock records SMS logs but sends no real SMS.
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_SENDER_ID=CHALIN03

# Arkesel Live SMS
# Put the real API key only in backend/.env, never in this example file.
SMS_ARKESEL_API_KEY=
SMS_ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2/sms/send
SMS_ARKESEL_REPORTS_URL=https://sms.arkesel.com/api/v2/sms/message-reports

# Automatic delivery confirmation
# The callback is sent with every Arkesel SMS when a webhook secret is present.
# Polling is also enabled as an automatic fallback, so staff do not confirm delivery.
SMS_DELIVERY_CALLBACK_URL=https://api.chalin03.com/api/sms/delivery-report
SMS_DELIVERY_WEBHOOK_SECRET=replace_with_unique_sms_webhook_secret
SMS_DELIVERY_POLL_ENABLED=true
SMS_DELIVERY_POLL_INTERVAL_MS=60000
SMS_DELIVERY_POLL_INITIAL_DELAY_MS=8000
SMS_DELIVERY_POLL_BATCH_SIZE=200
SMS_DELIVERY_POLL_LOOKBACK_HOURS=720
SMS_DELIVERY_POLL_MIN_AGE_SECONDS=30

# Hubtel optional backup
SMS_HUBTEL_CLIENT_ID=
SMS_HUBTEL_CLIENT_SECRET=
SMS_HUBTEL_BASE_URL=https://smsc.hubtel.com/v1/messages/send

# SMS Safety
SMS_TIMEOUT_MS=15000
SMS_MAX_BULK_RECIPIENTS=200
# Release 2A server-side session security
# Active sessions expire after eight hours or at Ghana midnight, whichever is earlier.
MAX_ACTIVE_SESSIONS_PER_USER=5
# Release 2A.2 secure SMS OTP recovery
# Production requires a different 64+ character random value from JWT_SECRET.
ACCOUNT_RECOVERY_OTP_SECRET=replace_with_unique_account_recovery_secret_64_chars_minimum

# Release 2 Final privileged security windows
PROTECTED_ACTION_WINDOW_MINUTES=10
OWNER_RECOVERY_SESSION_MINUTES=15
OWNER_RECOVERY_MAX_FAILED_ATTEMPTS=5
OWNER_MFA_ENCRYPTION_KEY=replace_with_unique_owner_mfa_encryption_secret_64_chars_minimum

# Release 3F-B automatic installment reminders.
# Keep false until management confirms live reminder timing and approved SMS credit use.
INSTALLMENT_SMS_REMINDERS_ENABLED=false
INSTALLMENT_REMINDER_INTERVAL_MINUTES=180

# CHALIN ONE feature controls.
# Every new capability fails closed and remains invisible until explicitly enabled.
# FEATURE_AI_ENABLED is the master emergency shutdown for every AI capability.
FEATURE_AI_ENABLED=false
FEATURE_PUBLIC_WEBSITE=false
FEATURE_CONTENT_STUDIO=false
FEATURE_CHALIN_COPILOT=false
FEATURE_CHALIN_EXECUTIVE=false
FEATURE_CHALIN_GUIDE=false
FEATURE_CUSTOMER_PORTAL=false
FEATURE_SUPPLIER_PORTAL=false
FEATURE_APPLICANT_PORTAL=false
FEATURE_AI_ACTIONS=false
FEATURE_AI_SCHEDULED_JOBS=false

# CHALIN ONE secure AI foundation.
# No provider is active by default. Provider secrets belong only in the real
# environment and are never stored in CHALIN ONE AI database tables.
AI_PROVIDER=disabled
# Deterministic mock provider is test-only. Never enable in production.
AI_ALLOW_MOCK_PROVIDER=false
AI_MOCK_MODEL=mock-v1
AI_MOCK_RESPONSE=CHALIN ONE isolated test response.
# Request, daily and monthly safety budgets. A monthly value of 0 disables cost
# enforcement until management approves a provider and pricing model.
AI_REQUEST_TOKEN_LIMIT=6000
AI_DAILY_USER_TOKEN_LIMIT=100000
AI_DAILY_WORKSPACE_TOKEN_LIMIT=1000000
AI_MAX_TOOL_CALLS_PER_REQUEST=6
AI_MONTHLY_COST_LIMIT_MICROS=0

# CHALIN ONE public website safety.
# Generate a unique 64+ character secret. Never reuse JWT or backup secrets.
# Production requires this value only when FEATURE_PUBLIC_WEBSITE=true.
PUBLIC_FORM_IP_HASH_SECRET=replace_with_unique_public_form_ip_hash_secret_64_chars_minimum
PUBLIC_CONTENT_READ_RATE_LIMIT_MAX=600
PUBLIC_FORM_SUBMISSION_RATE_LIMIT_MAX=12
# Scheduled publishing never runs more frequently than once per minute.
PUBLIC_CONTENT_SCHEDULER_INTERVAL_MS=60000

# CHALIN ONE Media Library.
# Development may use local storage. Local objects are never assigned public URLs.
# Production Content Studio media uploads require provider=r2 and all R2 values.
PUBLIC_MEDIA_STORAGE_PROVIDER=local
PUBLIC_MEDIA_LOCAL_ROOT=
PUBLIC_MEDIA_PUBLIC_BASE_URL=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=chalin03-public-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional comma-separated HTTPS video host allowlist. Defaults include
# YouTube, Vimeo and Cloudflare Stream hostnames.
PUBLIC_MEDIA_VIDEO_HOSTS=

# CHALIN ONE Phase 2 manual schema migration gates.
# These values must stay false/blank during normal backend startup and operation.
# For an isolated local/staging rehearsal, set the first two values only for the
# single command: npm run migrate:chalin-one:public-content
CHALIN_ONE_ALLOW_SCHEMA_MIGRATION=false
CHALIN_ONE_PUBLIC_CONTENT_MIGRATION_CONFIRM=
# Exact confirmation value required by the runner:
# 20260805_CHALIN_ONE_PUBLIC_CONTENT_FOUNDATION

# CHALIN ONE AI foundation manual schema migration gates.
# These values must also remain false/blank during normal startup and operation.
# For an isolated acceptance/development/staging rehearsal, enable only for:
# npm run migrate:chalin-one:ai-foundation
CHALIN_ONE_ALLOW_AI_SCHEMA_MIGRATION=false
CHALIN_ONE_AI_MIGRATION_CONFIRM=
# Exact confirmation value required by the AI runner:
# 20260806_CHALIN_ONE_AI_FOUNDATION

# Production migrations additionally require both separately verified backups.
CHALIN03_SIGNED_BACKUP_CONFIRMED=false
CHALIN03_SQL_BACKUP_CONFIRMED=false
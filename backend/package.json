{
  "name": "chalin03-backend",
  "version": "3.0.0",
  "description": "Backend API for Chalin 03 Sales and Inventory Management System",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/runEquipmentFinancePhaseOneSchemaStartup.js && node scripts/runEquipmentFinanceOperationalPolishStartup.js && node -r ./services/exportWorkbookSafetyBootstrap.js server.js",
    "dev": "nodemon server.js",
    "create-admin": "node scripts/createAdmin.js",
    "migrate:production": "node scripts/runProductionMigrations.js",
    "migrate:equipment-finance:production": "node scripts/runEquipmentFinanceProductionMigrations.js",
    "migrate:equipment-finance:professional:production": "node scripts/runEquipmentFinanceProfessionalRebuildMigration.js",
    "migrate:equipment-finance:operational-polish:production": "node scripts/runEquipmentFinanceOperationalPolishMigration.js",
    "migrate:equipment-finance:phase1-schema:production": "node scripts/runEquipmentFinancePhaseOneSchemaStartup.js",
    "syntax-check": "node --check server.js && node scripts/checkBackendSyntax.js",
    "migration-safety": "node scripts/verifyMigrationSafety.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "chalin03",
    "sales",
    "inventory",
    "mysql"
  ],
  "author": "Eugene Amankwah Appiah",
  "license": "ISC",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^3.0.3",
    "cors": "^4.18.0",
    "dotenv": "^16.0.0",
    "exceljs": "npm:@excel.js/exceljs@0.9.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.0.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
